*>================================================================*
*> PROGRAM-ID.    CICS-DISPATCHER.
*> AUTHOR.        KRISTJAN.
*> DATE-WRITTEN.  2025-03-28.
*> PURPOSE.       CICS-STYLE PSEUDO-CONVERSATIONAL TRANSACTION MONITOR
*>                - PCT (PROGRAM CONTROL TABLE) DYNAMIC DISPATCHING
*>                - TCT SESSION COMMAREA SERIALIZATION & DESERIALIZATION
*>                - MULTI-STEP PSEUDO-CONVERSATIONAL BANKING TRANS
*>                - TWO-PHASE LUW JOURNALING & DYNAMIC BACKOUT ROLLBACK
*>                - 3270 SIMULATED TERMINAL PRESENTATION
*>================================================================*
IDENTIFICATION DIVISION.
PROGRAM-ID. CICS-DISPATCHER.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "CICS-TABLES.cpy".
COPY "CICS-COMMAREA.cpy".
COPY "BMS-SCREEN.cpy".

01  WS-DISP-VARS.
    05  WS-PGM-NAME             PIC X(8).
    05  WS-I                    PIC 9(4) COMP-5.
    05  WS-J                    PIC 9(4) COMP-5.
    05  WS-FOUND                PIC X    VALUE "N".
    05  WS-LUW-NEXT-ID          PIC 9(6) COMP-5 VALUE 1001.
    05  WS-DISP-BAL             PIC $$,$$$,$$9.99.
    05  WS-DISP-OLD             PIC $$,$$$,$$9.99.
    05  WS-DISP-NEW             PIC $$,$$$,$$9.99.

PROCEDURE DIVISION.
0000-MAIN.
    DISPLAY "================================================================".
    DISPLAY "       CICS/VS PSEUDO-CONVERSATIONAL TRANSACTION MONITOR        ".
    DISPLAY "================================================================".
    PERFORM 1000-INIT-SYSTEM.

    PERFORM 2000-SCENARIO-INQUIRY.
    PERFORM 3000-SCENARIO-DEPOSIT.
    PERFORM 4000-SCENARIO-CONVERSATIONAL-TRANSFER.
    PERFORM 5000-SCENARIO-ABEND-AND-ROLLBACK.
    PERFORM 6000-SCENARIO-INTERLEAVED-CONCURRENCY.
    PERFORM 7000-SCENARIO-INSUFFICIENT-FUNDS.
    PERFORM 7500-SCENARIO-TELLER-CANCEL.

    DISPLAY "================================================================".
    DISPLAY "   CICS TRANSACTION MONITOR DEMO COMPLETED [PASS 100% OK]       ".
    DISPLAY "================================================================".
    MOVE 0 TO RETURN-CODE.
    STOP RUN.

1000-INIT-SYSTEM.
    DISPLAY ">> Bootstrapping CICS Region: Initializing PCT, TCT, & Master Accounts...".
    *> Setup Account Master Database
    MOVE 4 TO ACCT-COUNT.
    MOVE "ACCT1001" TO ACC-ID(1). MOVE "Alice Smith" TO ACC-NAME(1).
    MOVE 5000.00 TO ACC-BALANCE(1). MOVE "A" TO ACC-STATUS(1).

    MOVE "ACCT1002" TO ACC-ID(2). MOVE "Bob Jones" TO ACC-NAME(2).
    MOVE 2500.00 TO ACC-BALANCE(2). MOVE "A" TO ACC-STATUS(2).

    MOVE "ACCT1003" TO ACC-ID(3). MOVE "Charlie Brown" TO ACC-NAME(3).
    MOVE 10000.00 TO ACC-BALANCE(3). MOVE "A" TO ACC-STATUS(3).

    MOVE "ACCT1004" TO ACC-ID(4). MOVE "Diana Prince" TO ACC-NAME(4).
    MOVE 750.00 TO ACC-BALANCE(4). MOVE "A" TO ACC-STATUS(4).

    *> Setup PCT Table
    MOVE "INQ1" TO PCT-TRANS-ID(1). MOVE "INQ1PGM " TO PCT-PROGRAM-NAME(1).
    MOVE "Account Inquiry         " TO PCT-DESCRIPTION(1).

    MOVE "DEP1" TO PCT-TRANS-ID(2). MOVE "DEP1PGM " TO PCT-PROGRAM-NAME(2).
    MOVE "Cash Deposit            " TO PCT-DESCRIPTION(2).

    MOVE "XFR1" TO PCT-TRANS-ID(3). MOVE "XFR1PGM " TO PCT-PROGRAM-NAME(3).
    MOVE "Fund Transfer Step 1    " TO PCT-DESCRIPTION(3).

    MOVE "XFR2" TO PCT-TRANS-ID(4). MOVE "XFR2PGM " TO PCT-PROGRAM-NAME(4).
    MOVE "Fund Transfer Step 2    " TO PCT-DESCRIPTION(4).

    MOVE "XFR3" TO PCT-TRANS-ID(5). MOVE "XFR3PGM " TO PCT-PROGRAM-NAME(5).
    MOVE "Fund Transfer Step 3    " TO PCT-DESCRIPTION(5).

    *> Setup TCT Terminals
    MOVE "TR01" TO TCT-TERM-ID(1). MOVE "TELLER01" TO TCT-USER-ID(1).
    MOVE SPACES TO TCT-ACTIVE-TRANS(1) TCT-NEXT-TRANS(1).

    MOVE "TR02" TO TCT-TERM-ID(2). MOVE "TELLER02" TO TCT-USER-ID(2).
    MOVE SPACES TO TCT-ACTIVE-TRANS(2) TCT-NEXT-TRANS(2).
    DISPLAY ">> CICS Region active. 4 Accounts loaded, 5 PCT transactions ready.".

2000-SCENARIO-INQUIRY.
    DISPLAY " ".
    DISPLAY "--- TEST 1: STATELESS INQUIRY (TRANS: INQ1) ---".
    INITIALIZE DFHCOMMAREA.
    MOVE "TR01"     TO CA-TERMID.
    MOVE "TELLER01" TO CA-USERID.
    MOVE "INQ1"     TO CA-TRANSID.
    MOVE "ACCT1001" TO INQ-ACCT-NO.
    MOVE "ENTR"     TO CA-AID-KEY.

    PERFORM 8000-DISPATCH-TRANSACTION.
    MOVE INQ-BALANCE TO WS-DISP-BAL.
    DISPLAY " [PASS] INQ1 Result: Account " INQ-ACCT-NO " (" INQ-ACCT-NAME ") Balance = " WS-DISP-BAL.

3000-SCENARIO-DEPOSIT.
    DISPLAY " ".
    DISPLAY "--- TEST 2: SINGLE-STEP DEPOSIT WITH JOURNAL LOGGING (TRANS: DEP1) ---".
    INITIALIZE DFHCOMMAREA.
    MOVE "TR01"     TO CA-TERMID.
    MOVE "TELLER01" TO CA-USERID.
    MOVE "DEP1"     TO CA-TRANSID.
    MOVE "ACCT1002" TO DEP-ACCT-NO.
    MOVE 1500.00    TO DEP-AMOUNT.
    MOVE "ENTR"     TO CA-AID-KEY.

    PERFORM 8000-DISPATCH-TRANSACTION.
    MOVE DEP-NEW-BALANCE TO WS-DISP-BAL.
    DISPLAY " [PASS] DEP1 Result: Account " DEP-ACCT-NO " credited $1,500.00. New Balance = " WS-DISP-BAL.

4000-SCENARIO-CONVERSATIONAL-TRANSFER.
    DISPLAY " ".
    DISPLAY "--- TEST 3: 3-STEP PSEUDO-CONVERSATIONAL TRANSFER (XFR1 -> XFR2 -> XFR3) ---".
    DISPLAY ">> Step 1: Teller initiates $1,000 transfer from ACCT1001 to ACCT1002...".
    INITIALIZE DFHCOMMAREA.
    MOVE "TR01"     TO CA-TERMID.
    MOVE "TELLER01" TO CA-USERID.
    MOVE "XFR1"     TO CA-TRANSID.
    MOVE "ACCT1001" TO XFR-FROM-ACCT.
    MOVE "ACCT1002" TO XFR-TO-ACCT.
    MOVE 1000.00    TO XFR-AMOUNT.
    MOVE "ENTR"     TO CA-AID-KEY.
    PERFORM 8000-DISPATCH-TRANSACTION.

    DISPLAY ">> Step 2: Teller reviews confirmation screen and presses ENTER...".
    *> Resume from saved session COMMAREA
    MOVE TCT-SAVED-COMMAREA(1) TO DFHCOMMAREA.
    MOVE TCT-NEXT-TRANS(1)     TO CA-TRANSID.
    MOVE "ENTR"                TO CA-AID-KEY.
    PERFORM 8000-DISPATCH-TRANSACTION.

    DISPLAY ">> Step 3: Transaction engine executes two-phase debit & credit...".
    MOVE TCT-SAVED-COMMAREA(1) TO DFHCOMMAREA.
    MOVE TCT-NEXT-TRANS(1)     TO CA-TRANSID.
    MOVE "ENTR"                TO CA-AID-KEY.
    PERFORM 8000-DISPATCH-TRANSACTION.

    MOVE ACC-BALANCE(1) TO WS-DISP-OLD.
    MOVE ACC-BALANCE(2) TO WS-DISP-NEW.
    DISPLAY " [PASS] 3-Step Transfer Complete. ACCT1001 (Source) = " WS-DISP-OLD
            " | ACCT1002 (Target) = " WS-DISP-NEW.

5000-SCENARIO-ABEND-AND-ROLLBACK.
    DISPLAY " ".
    DISPLAY "--- TEST 4: ABEND & DYNAMIC TRANSACTION BACKOUT (ROLLBACK) ---".
    DISPLAY ">> Initiating transfer to invalid account ACCT9999 to force credit ABEND...".
    INITIALIZE DFHCOMMAREA.
    MOVE "TR01"     TO CA-TERMID.
    MOVE "TELLER01" TO CA-USERID.
    MOVE "XFR1"     TO CA-TRANSID.
    MOVE "ACCT1001" TO XFR-FROM-ACCT.
    MOVE "ACCT9999" TO XFR-TO-ACCT.
    MOVE 500.00     TO XFR-AMOUNT.
    MOVE "ENTR"     TO CA-AID-KEY.
    PERFORM 8000-DISPATCH-TRANSACTION.

    *> Step 2 Confirmation
    MOVE TCT-SAVED-COMMAREA(1) TO DFHCOMMAREA.
    MOVE TCT-NEXT-TRANS(1)     TO CA-TRANSID.
    MOVE "ENTR"                TO CA-AID-KEY.
    PERFORM 8000-DISPATCH-TRANSACTION.

    *> Step 3 Settlement -> Will abend on invalid destination!
    MOVE TCT-SAVED-COMMAREA(1) TO DFHCOMMAREA.
    MOVE TCT-NEXT-TRANS(1)     TO CA-TRANSID.
    MOVE "ENTR"                TO CA-AID-KEY.
    PERFORM 8000-DISPATCH-TRANSACTION.

    MOVE ACC-BALANCE(1) TO WS-DISP-BAL.
    DISPLAY " [PASS] Post-Rollback Integrity Check: ACCT1001 Balance = " WS-DISP-BAL 
            " (Fully Restored, Zero Leakage).".

6000-SCENARIO-INTERLEAVED-CONCURRENCY.
    DISPLAY " ".
    DISPLAY "--- TEST 5: INTERLEAVED MULTI-TERMINAL CONCURRENCY (TR01 & TR02) ---".
    DISPLAY ">> TR01 initiates transfer XFR1 while TR02 performs deposit DEP1...".

    *> 1. TR01 initiates XFR1
    INITIALIZE DFHCOMMAREA.
    MOVE "TR01"     TO CA-TERMID.
    MOVE "TELLER01" TO CA-USERID.
    MOVE "XFR1"     TO CA-TRANSID.
    MOVE "ACCT1003" TO XFR-FROM-ACCT.
    MOVE "ACCT1004" TO XFR-TO-ACCT.
    MOVE 500.00     TO XFR-AMOUNT.
    MOVE "ENTR"     TO CA-AID-KEY.
    PERFORM 8000-DISPATCH-TRANSACTION.

    *> 2. Interleaved: TR02 performs deposit DEP1 on ACCT1004
    INITIALIZE DFHCOMMAREA.
    MOVE "TR02"     TO CA-TERMID.
    MOVE "TELLER02" TO CA-USERID.
    MOVE "DEP1"     TO CA-TRANSID.
    MOVE "ACCT1004" TO DEP-ACCT-NO.
    MOVE 250.00     TO DEP-AMOUNT.
    MOVE "ENTR"     TO CA-AID-KEY.
    PERFORM 8000-DISPATCH-TRANSACTION.

    *> 3. TR01 resumes XFR2 confirmation
    MOVE TCT-SAVED-COMMAREA(1) TO DFHCOMMAREA.
    MOVE TCT-NEXT-TRANS(1)     TO CA-TRANSID.
    MOVE "ENTR"                TO CA-AID-KEY.
    PERFORM 8000-DISPATCH-TRANSACTION.

    *> 4. TR01 settles XFR3
    MOVE TCT-SAVED-COMMAREA(1) TO DFHCOMMAREA.
    MOVE TCT-NEXT-TRANS(1)     TO CA-TRANSID.
    MOVE "ENTR"                TO CA-AID-KEY.
    PERFORM 8000-DISPATCH-TRANSACTION.

    MOVE ACC-BALANCE(4) TO WS-DISP-BAL.
    DISPLAY " [PASS] Interleaved Concurrency Verified. ACCT1004 Final Balance = " WS-DISP-BAL.

7000-SCENARIO-INSUFFICIENT-FUNDS.
    DISPLAY " ".
    DISPLAY "--- TEST 6: INSUFFICIENT FUNDS ERROR HANDLING (RESP=16) ---".
    INITIALIZE DFHCOMMAREA.
    MOVE "TR01"     TO CA-TERMID.
    MOVE "TELLER01" TO CA-USERID.
    MOVE "XFR1"     TO CA-TRANSID.
    MOVE "ACCT1001" TO XFR-FROM-ACCT.
    MOVE "ACCT1002" TO XFR-TO-ACCT.
    MOVE 9999999.00 TO XFR-AMOUNT.
    MOVE "ENTR"     TO CA-AID-KEY.
    PERFORM 8000-DISPATCH-TRANSACTION.
    DISPLAY " [PASS] Insufficient funds rejected with EIBRESP=" CA-EIBRESP.

7500-SCENARIO-TELLER-CANCEL.
    DISPLAY " ".
    DISPLAY "--- TEST 7: TELLER ABORT VIA PF03 CANCEL KEY ---".
    INITIALIZE DFHCOMMAREA.
    MOVE "TR01"     TO CA-TERMID.
    MOVE "TELLER01" TO CA-USERID.
    MOVE "XFR2"     TO CA-TRANSID.
    MOVE "PF03"     TO CA-AID-KEY.
    PERFORM 8000-DISPATCH-TRANSACTION.
    DISPLAY " [PASS] Transfer cancellation acknowledged: " XFR-STATUS-MSG.

8000-DISPATCH-TRANSACTION.
    MOVE "N" TO WS-FOUND.
    MOVE SPACES TO WS-PGM-NAME.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > PCT-COUNT
        IF PCT-TRANS-ID(WS-I) = CA-TRANSID
            MOVE PCT-PROGRAM-NAME(WS-I) TO WS-PGM-NAME
            MOVE "Y" TO WS-FOUND
            EXIT PERFORM
        END-IF
    END-PERFORM.

    IF WS-FOUND = "N"
        DISPLAY " [CICS ERROR] TRANS-ID NOT FOUND IN PCT: " CA-TRANSID
        MOVE 16 TO CA-EIBRESP
        EXIT PARAGRAPH
    END-IF.

    *> Dynamically call CICS transaction subprogram
    CALL WS-PGM-NAME USING DFHCOMMAREA, ACCOUNT-DATABASE, JOURNAL-TABLE.

    *> Inspect execution status
    IF CA-EIBRESP = 0
        IF CA-NEXT-TRANSID NOT = SPACES
            MOVE CA-NEXT-TRANSID TO TCT-NEXT-TRANS(1)
            MOVE DFHCOMMAREA     TO TCT-SAVED-COMMAREA(1)
            DISPLAY "   [CICS TCT] State persisted. Next Trans: " CA-NEXT-TRANSID
        ELSE
            MOVE SPACES TO TCT-NEXT-TRANS(1)
            DISPLAY "   [CICS TCT] Transaction finished. Terminal session released."
        END-IF
    ELSE
        IF CA-EIBRESP = 99
            DISPLAY "   *** CICS ABEND INTERCEPTED BY DISPATCHER (RESP=99) ***"
            PERFORM 9000-ROLLBACK-LUW
        END-IF
    END-IF.

9000-ROLLBACK-LUW.
    DISPLAY "   [CICS DTB] ROLLING BACK PENDING JOURNAL MODIFICATIONS...".
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > JRN-COUNT
        IF JRN-STATUS(WS-I) = "P"
            PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > ACCT-COUNT
                IF ACC-ID(WS-J) = JRN-ACCT-ID(WS-I)
                    MOVE JRN-OLD-BAL(WS-I) TO ACC-BALANCE(WS-J)
                    MOVE "R" TO JRN-STATUS(WS-I)
                    MOVE ACC-BALANCE(WS-J) TO WS-DISP-BAL
                    DISPLAY "   [CICS RESTORE] Reverted " ACC-ID(WS-J) " to " WS-DISP-BAL
                END-IF
            END-PERFORM
        END-IF
    END-PERFORM.
    MOVE SPACES TO TCT-NEXT-TRANS(1).
    DISPLAY "   [CICS DTB] Dynamic transaction backout completed cleanly.".

END PROGRAM CICS-DISPATCHER.

*>================================================================*
*> PROGRAM-ID.    INQ1PGM.
*> PURPOSE.       CICS INQUIRY SUBPROGRAM
*>================================================================*
IDENTIFICATION DIVISION.
PROGRAM-ID. INQ1PGM.

DATA DIVISION.
WORKING-STORAGE SECTION.
01  WS-I                        PIC 9(4) COMP-5.

LINKAGE SECTION.
COPY "CICS-COMMAREA.cpy".
COPY "CICS-TABLES.cpy".

01  LK-JOURNAL-TABLE.
    05  LK-JRN-COUNT            PIC 9(4) COMP-5.
    05  LK-JRN-ENTRY OCCURS 16 TIMES.
        10  LK-JRN-LUW-ID       PIC 9(6) COMP-5.
        10  LK-JRN-TRANS-ID     PIC X(4).
        10  LK-JRN-ACCT-ID      PIC X(8).
        10  LK-JRN-OLD-BAL      PIC S9(9)V99 COMP-3.
        10  LK-JRN-NEW-BAL      PIC S9(9)V99 COMP-3.
        10  LK-JRN-STATUS       PIC X.

PROCEDURE DIVISION USING DFHCOMMAREA, ACCOUNT-DATABASE, LK-JOURNAL-TABLE.
0000-INQ.
    MOVE 13 TO CA-EIBRESP.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > ACCT-COUNT
        IF ACC-ID(WS-I) = INQ-ACCT-NO
            MOVE ACC-NAME(WS-I)    TO INQ-ACCT-NAME
            MOVE ACC-BALANCE(WS-I) TO INQ-BALANCE
            MOVE "ACCOUNT LOCATED - ACTIVE" TO INQ-STATUS-MSG
            MOVE 0 TO CA-EIBRESP
            MOVE SPACES TO CA-NEXT-TRANSID
            EXIT PERFORM
        END-IF
    END-PERFORM.
    GOBACK.
END PROGRAM INQ1PGM.

*>================================================================*
*> PROGRAM-ID.    DEP1PGM.
*> PURPOSE.       CICS DEPOSIT SUBPROGRAM WITH COMMITTED JOURNAL
*>================================================================*
IDENTIFICATION DIVISION.
PROGRAM-ID. DEP1PGM.

DATA DIVISION.
WORKING-STORAGE SECTION.
01  WS-I                        PIC 9(4) COMP-5.

LINKAGE SECTION.
COPY "CICS-COMMAREA.cpy".
COPY "CICS-TABLES.cpy".

01  LK-JOURNAL-TABLE.
    05  LK-JRN-COUNT            PIC 9(4) COMP-5.
    05  LK-JRN-ENTRY OCCURS 16 TIMES.
        10  LK-JRN-LUW-ID       PIC 9(6) COMP-5.
        10  LK-JRN-TRANS-ID     PIC X(4).
        10  LK-JRN-ACCT-ID      PIC X(8).
        10  LK-JRN-OLD-BAL      PIC S9(9)V99 COMP-3.
        10  LK-JRN-NEW-BAL      PIC S9(9)V99 COMP-3.
        10  LK-JRN-STATUS       PIC X.

PROCEDURE DIVISION USING DFHCOMMAREA, ACCOUNT-DATABASE, LK-JOURNAL-TABLE.
0000-DEP.
    MOVE 13 TO CA-EIBRESP.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > ACCT-COUNT
        IF ACC-ID(WS-I) = DEP-ACCT-NO
            *> Write Journal Record
            ADD 1 TO LK-JRN-COUNT
            MOVE 1001              TO LK-JRN-LUW-ID(LK-JRN-COUNT)
            MOVE "DEP1"            TO LK-JRN-TRANS-ID(LK-JRN-COUNT)
            MOVE DEP-ACCT-NO       TO LK-JRN-ACCT-ID(LK-JRN-COUNT)
            MOVE ACC-BALANCE(WS-I) TO LK-JRN-OLD-BAL(LK-JRN-COUNT)

            ADD DEP-AMOUNT TO ACC-BALANCE(WS-I)

            MOVE ACC-BALANCE(WS-I) TO LK-JRN-NEW-BAL(LK-JRN-COUNT)
            MOVE "C"               TO LK-JRN-STATUS(LK-JRN-COUNT)
            MOVE ACC-BALANCE(WS-I) TO DEP-NEW-BALANCE
            MOVE "DEPOSIT POSTED SUCCESSFULLY" TO DEP-STATUS-MSG
            MOVE 0 TO CA-EIBRESP
            MOVE SPACES TO CA-NEXT-TRANSID
            EXIT PERFORM
        END-IF
    END-PERFORM.
    GOBACK.
END PROGRAM DEP1PGM.

*>================================================================*
*> PROGRAM-ID.    XFR1PGM.
*> PURPOSE.       TRANSFER STEP 1: VALIDATE BALANCE & ASSESS FEE
*>================================================================*
IDENTIFICATION DIVISION.
PROGRAM-ID. XFR1PGM.

DATA DIVISION.
WORKING-STORAGE SECTION.
01  WS-I                        PIC 9(4) COMP-5.

LINKAGE SECTION.
COPY "CICS-COMMAREA.cpy".
COPY "CICS-TABLES.cpy".

01  LK-JOURNAL-TABLE.
    05  LK-JRN-COUNT            PIC 9(4) COMP-5.
    05  LK-JRN-ENTRY OCCURS 16 TIMES.
        10  LK-JRN-LUW-ID       PIC 9(6) COMP-5.
        10  LK-JRN-TRANS-ID     PIC X(4).
        10  LK-JRN-ACCT-ID      PIC X(8).
        10  LK-JRN-OLD-BAL      PIC S9(9)V99 COMP-3.
        10  LK-JRN-NEW-BAL      PIC S9(9)V99 COMP-3.
        10  LK-JRN-STATUS       PIC X.

PROCEDURE DIVISION USING DFHCOMMAREA, ACCOUNT-DATABASE, LK-JOURNAL-TABLE.
0000-XFR1.
    MOVE 13 TO CA-EIBRESP.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > ACCT-COUNT
        IF ACC-ID(WS-I) = XFR-FROM-ACCT
            IF ACC-BALANCE(WS-I) >= (XFR-AMOUNT + 5.00)
                MOVE 5.00   TO XFR-FEE
                MOVE 2      TO XFR-STEP
                MOVE "XFR2" TO CA-NEXT-TRANSID
                MOVE "PLEASE CONFIRM (ENTER=PROCEED, PF3=CANCEL)"
                     TO XFR-STATUS-MSG
                MOVE 0 TO CA-EIBRESP
            ELSE
                MOVE 16 TO CA-EIBRESP
                MOVE "INSUFFICIENT FUNDS IN SOURCE ACCOUNT" TO XFR-STATUS-MSG
            END-IF
            EXIT PERFORM
        END-IF
    END-PERFORM.
    GOBACK.
END PROGRAM XFR1PGM.

*>================================================================*
*> PROGRAM-ID.    XFR2PGM.
*> PURPOSE.       TRANSFER STEP 2: TELLER CONFIRMATION / REJECTION
*>================================================================*
IDENTIFICATION DIVISION.
PROGRAM-ID. XFR2PGM.

DATA DIVISION.
LINKAGE SECTION.
COPY "CICS-COMMAREA.cpy".
COPY "CICS-TABLES.cpy".

01  LK-JOURNAL-TABLE.
    05  LK-JRN-COUNT            PIC 9(4) COMP-5.
    05  LK-JRN-ENTRY OCCURS 16 TIMES.
        10  LK-JRN-LUW-ID       PIC 9(6) COMP-5.
        10  LK-JRN-TRANS-ID     PIC X(4).
        10  LK-JRN-ACCT-ID      PIC X(8).
        10  LK-JRN-OLD-BAL      PIC S9(9)V99 COMP-3.
        10  LK-JRN-NEW-BAL      PIC S9(9)V99 COMP-3.
        10  LK-JRN-STATUS       PIC X.

PROCEDURE DIVISION USING DFHCOMMAREA, ACCOUNT-DATABASE, LK-JOURNAL-TABLE.
0000-XFR2.
    IF CA-AID-KEY = "ENTR"
        MOVE "Y"    TO XFR-CONFIRMED
        MOVE 3      TO XFR-STEP
        MOVE "XFR3" TO CA-NEXT-TRANSID
        MOVE "TRANSFER CONFIRMED - POSTING TO LEDGER" TO XFR-STATUS-MSG
        MOVE 0 TO CA-EIBRESP
    ELSE
        MOVE SPACES TO CA-NEXT-TRANSID
        MOVE "TRANSFER ABORTED BY TELLER" TO XFR-STATUS-MSG
        MOVE 0 TO CA-EIBRESP
    END-IF.
    GOBACK.
END PROGRAM XFR2PGM.

*>================================================================*
*> PROGRAM-ID.    XFR3PGM.
*> PURPOSE.       TRANSFER STEP 3: TWO-PHASE SETTLEMENT & ABEND CHECK
*>================================================================*
IDENTIFICATION DIVISION.
PROGRAM-ID. XFR3PGM.

DATA DIVISION.
WORKING-STORAGE SECTION.
01  WS-SRC-IDX                  PIC 9(4) COMP-5 VALUE 0.
01  WS-DST-IDX                  PIC 9(4) COMP-5 VALUE 0.
01  WS-I                        PIC 9(4) COMP-5.

LINKAGE SECTION.
COPY "CICS-COMMAREA.cpy".
COPY "CICS-TABLES.cpy".

01  LK-JOURNAL-TABLE.
    05  LK-JRN-COUNT            PIC 9(4) COMP-5.
    05  LK-JRN-ENTRY OCCURS 16 TIMES.
        10  LK-JRN-LUW-ID       PIC 9(6) COMP-5.
        10  LK-JRN-TRANS-ID     PIC X(4).
        10  LK-JRN-ACCT-ID      PIC X(8).
        10  LK-JRN-OLD-BAL      PIC S9(9)V99 COMP-3.
        10  LK-JRN-NEW-BAL      PIC S9(9)V99 COMP-3.
        10  LK-JRN-STATUS       PIC X.

PROCEDURE DIVISION USING DFHCOMMAREA, ACCOUNT-DATABASE, LK-JOURNAL-TABLE.
0000-XFR3.
    MOVE 0 TO WS-SRC-IDX.
    MOVE 0 TO WS-DST-IDX.
    *> 1. Debit Source Account and record in Journal as Pending (P)
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > ACCT-COUNT
        IF ACC-ID(WS-I) = XFR-FROM-ACCT
            MOVE WS-I TO WS-SRC-IDX
            ADD 1 TO LK-JRN-COUNT
            MOVE 2002              TO LK-JRN-LUW-ID(LK-JRN-COUNT)
            MOVE "XFR3"            TO LK-JRN-TRANS-ID(LK-JRN-COUNT)
            MOVE XFR-FROM-ACCT     TO LK-JRN-ACCT-ID(LK-JRN-COUNT)
            MOVE ACC-BALANCE(WS-I) TO LK-JRN-OLD-BAL(LK-JRN-COUNT)

            COMPUTE ACC-BALANCE(WS-I) = ACC-BALANCE(WS-I) - (XFR-AMOUNT + XFR-FEE)

            MOVE ACC-BALANCE(WS-I) TO LK-JRN-NEW-BAL(LK-JRN-COUNT)
            MOVE "P"               TO LK-JRN-STATUS(LK-JRN-COUNT)
            EXIT PERFORM
        END-IF
    END-PERFORM.

    *> 2. Credit Destination Account
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > ACCT-COUNT
        IF ACC-ID(WS-I) = XFR-TO-ACCT
            MOVE WS-I TO WS-DST-IDX
            ADD XFR-AMOUNT TO ACC-BALANCE(WS-I)
            EXIT PERFORM
        END-IF
    END-PERFORM.

    *> 3. Check for ABEND condition (Destination Account missing!)
    IF WS-DST-IDX = 0
        MOVE 99 TO CA-EIBRESP
        MOVE "TARGET ACCOUNT NOT FOUND - TRIGGERING ABEND" TO XFR-STATUS-MSG
        GOBACK
    END-IF.

    *> 4. Commit transaction
    MOVE "C" TO LK-JRN-STATUS(LK-JRN-COUNT).
    MOVE SPACES TO CA-NEXT-TRANSID.
    MOVE "TRANSFER SETTLED SUCCESSFULLY" TO XFR-STATUS-MSG.
    MOVE 0 TO CA-EIBRESP.
    GOBACK.
END PROGRAM XFR3PGM.

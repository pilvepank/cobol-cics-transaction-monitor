@echo off
set "COB_MAIN_DIR=C:\GnuCOBOL\"
set "PATH=%COB_MAIN_DIR%bin;%PATH%"
set "COB_CONFIG_DIR=%COB_MAIN_DIR%config"
set "COB_COPY_DIR=%COB_MAIN_DIR%copy"
echo Building CICS Dispatcher...
cobc -free -x -Wall -Icopybooks src\cics_dispatcher.cbl -o cics_dispatcher.exe
echo Building CICS Test...
cobc -free -x -Wall -Icopybooks tests\cics_test.cbl -o cics_test.exe
echo Building Auth Test...
cobc -free -x -Wall -Icopybooks tests\cics_auth_test.cbl src\cics_racf_auth.cbl -o cics_auth_test.exe
echo Building BMS Test...
cobc -free -x -Wall -Icopybooks tests\cics_bms_test.cbl src\cics_bms_compiler.cbl -o cics_bms_test.exe
echo Building Recovery Test...
cobc -free -x -Wall -Icopybooks tests\cics_recovery_test.cbl src\cics_journal_recovery.cbl -o cics_recovery_test.exe
echo Building Interval Control Test...
cobc -free -x -Wall -Icopybooks tests\cics_icp_test.cbl src\cics_interval_control.cbl -o cics_icp_test.exe
echo Building ENQ/DEQ Test...
cobc -free -x -Wall -Icopybooks tests\cics_enq_test.cbl src\cics_enq_deq.cbl -o cics_enq_test.exe
echo Building LINK/XCTL Test...
cobc -free -x -Wall -Icopybooks tests\cics_link_test.cbl src\cics_link_xctl.cbl -o cics_link_test.exe
